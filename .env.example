# Enterprise Warranty Hub (EWH) Environment Configuration

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/enterprise_warranty
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=enterprise_warranty

# Session Secret (used for signing HttpOnly session cookies)
SESSION_SECRET=enterprise-warranty-hub-secure-random-academic-key-32chars

# Application Environment
NODE_ENV=development
PORT=3000
