{
  "name": "enterprise-warranty-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Warranty Hub - Demo-First DBMS Project",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/run-tests.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:setup": "node --import tsx scripts/setup.ts",
    "db:reset": "node --import tsx scripts/reset.ts",
    "model:download": "node --import tsx scripts/init-model.ts",
    "docs:generate": "python scripts/generate-academic-docs.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "14.2.24",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
